<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Portfel.ViewModels"
             x:Class="Portfel.Views.DebtsView"
             x:DataType="vm:DebtsPageViewModel"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,24,30,34" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Text="Spłaty bez ręcznego odejmowania" Classes="h2" /><TextBlock Text="Dodajesz kwotę długu, a każda operacja „Spłata długu” zmniejsza saldo." Classes="muted" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        <Button Grid.Column="1" Classes="primary" Content="＋ Dodaj dług" Command="{Binding Shell.AddDebtCommand}" />
      </Grid>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
          <StackPanel><TextBlock Text="DŁUGI ŁĄCZNIE" Classes="eyebrow" /><TextBlock Text="{Binding Shell.DebtsTotal}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="Kwota początkowa" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="SPŁACONO" Classes="eyebrow" /><TextBlock Text="{Binding Shell.DebtsPaid}" Classes="metric positive" Margin="0,6,0,0" /><TextBlock Text="Z zaksięgowanych spłat" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="POZOSTAŁO" Classes="eyebrow" /><TextBlock Text="{Binding Shell.DebtsRemaining}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="Aktualne saldo zadłużenia" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="ZALECANA RATA" Classes="eyebrow" /><TextBlock Text="{Binding Shell.DebtsRecommended}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="Łącznie według terminów" Classes="muted" FontSize="10" /></StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Shell.DebtCards}" IsVisible="{Binding Shell.HasDebts}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="385" Margin="0,0,14,14">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel><TextBlock Text="{Binding Name}" Classes="h2" /><TextBlock Text="{Binding Deadline}" Classes="muted" FontSize="10" /></StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="9,5"><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Classes.positive="{Binding IsComplete}" Classes.negative="{Binding IsOverdue}" /></Border>
                </Grid>
                <ProgressBar Value="{Binding Percent}" Maximum="100" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <StackPanel><TextBlock Text="SPŁACONO" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Paid}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="KWOTA" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Total}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="ZOSTAŁO" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Remaining}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                </Grid>
                <Border Classes="soft-card">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Zalecana rata miesięczna" Classes="muted" FontSize="10" /><TextBlock Text="{Binding Interest}" Classes="muted" FontSize="9" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Recommended}" FontSize="18" FontWeight="SemiBold" Foreground="#F4A261" VerticalAlignment="Center" /></Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Classes="primary" Content="Dodaj spłatę" HorizontalAlignment="Left" Command="{Binding $parent[UserControl].DataContext.Shell.AddDebtPaymentCommand}" CommandParameter="{Binding Id}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="tiny" Content="Edytuj" Command="{Binding $parent[UserControl].DataContext.Shell.EditDebtCommand}" CommandParameter="{Binding Id}" />
                    <Button Classes="tiny danger" Content="×" Command="{Binding $parent[UserControl].DataContext.Shell.DeleteDebtCommand}" CommandParameter="{Binding Id}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" IsVisible="{Binding !Shell.HasDebts}">
        <StackPanel Margin="0,34" HorizontalAlignment="Center" Spacing="10">
          <Border Width="60" Height="60" CornerRadius="30" Background="#18F4A261"><TextBlock Text="↘" FontSize="28" Foreground="#D1792B" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Nie masz wpisanych długów" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Po dodaniu długu spłacasz go zwykłymi operacjami. Pozostała kwota policzy się sama." Classes="muted" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
          <Button Classes="primary" Content="Dodaj pierwszy dług" Command="{Binding Shell.AddDebtCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

