<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Portfel.ViewModels"
             x:Class="Portfel.Views.AnalyticsView"
             x:DataType="vm:AnalyticsPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,24,30,34" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Text="Cały rok bez dodatkowego uzupełniania" Classes="h2" /><TextBlock Text="Podsumowanie powstaje automatycznie z dwunastu miesięcy." Classes="muted" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        <ComboBox Grid.Column="1" Width="110" ItemsSource="{Binding Shell.Years}" SelectedItem="{Binding Shell.SelectedYear}" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Border Classes="card"><StackPanel Spacing="7"><TextBlock Text="WPŁYWY W ROKU" Classes="eyebrow" /><TextBlock Text="{Binding Shell.AnnualIncome}" Classes="metric positive" /><TextBlock Text="Wszystkie wpływy z 12 miesięcy" Classes="muted" FontSize="10" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Text="ODPŁYWY W ROKU" Classes="eyebrow" /><TextBlock Text="{Binding Shell.AnnualOutflow}" Classes="metric" /><TextBlock Text="Wydatki, cele i długi" Classes="muted" FontSize="10" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Text="BILANS ROKU" Classes="eyebrow" /><TextBlock Text="{Binding Shell.AnnualNet}" Classes="metric" /><TextBlock Text="Wpływy minus wszystkie odpływy" Classes="muted" FontSize="10" /></StackPanel></Border>
      </Grid>

      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
        <Border Classes="card">
          <StackPanel Spacing="17">
            <StackPanel><TextBlock Text="Miesiąc po miesiącu" Classes="h2" /><TextBlock Text="Porównanie wpływów i odpływów" Classes="muted" FontSize="10" /></StackPanel>
            <ItemsControl ItemsSource="{Binding Shell.AnnualBars}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthBar">
                  <Grid RowDefinitions="220,Auto" Margin="5,0">
                    <Grid VerticalAlignment="Bottom" ColumnDefinitions="*,*" ColumnSpacing="3">
                      <Border VerticalAlignment="Bottom" Height="{Binding IncomeHeight}" Background="{DynamicResource AccentBrush}" CornerRadius="4,4,1,1" ToolTip.Tip="{Binding Income}" />
                      <Border Grid.Column="1" VerticalAlignment="Bottom" Height="{Binding OutflowHeight}" Background="#F4A261" CornerRadius="4,4,1,1" ToolTip.Tip="{Binding Outflow}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Month}" Classes="muted" FontSize="9" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AccentBrush}" /><TextBlock Text="Wpływy" Classes="muted" FontSize="10" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="9" Height="9" CornerRadius="5" Background="#F4A261" /><TextBlock Text="Odpływy" Classes="muted" FontSize="10" /></StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="15">
            <StackPanel><TextBlock Text="Kategorie wydatków" Classes="h2" /><TextBlock Text="Udział w wydatkach całego roku" Classes="muted" FontSize="10" /></StackPanel>
            <ItemsControl ItemsSource="{Binding Shell.CategorySlices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CategorySlice">
                  <StackPanel Spacing="6" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Amount}" Classes="muted" FontSize="10" /></Grid>
                    <Grid Height="7"><Border Background="{DynamicResource LineBrush}" CornerRadius="4" /><Border Width="{Binding Percent}" MinWidth="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="4" /></Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Kategorie pojawią się po dodaniu wydatków." Classes="muted" FontSize="10" IsVisible="{Binding !Shell.HasCategorySlices}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="13">
          <TextBlock Text="Podsumowanie miesięcy" Classes="h2" />
          <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12,9">
            <Grid ColumnDefinitions="*,*,*"><TextBlock Text="MIESIĄC" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="WPŁYWY" Classes="eyebrow" TextAlignment="Right" /><TextBlock Grid.Column="2" Text="ODPŁYWY" Classes="eyebrow" TextAlignment="Right" /></Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Shell.AnnualBars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MonthBar">
                <Grid ColumnDefinitions="*,*,*" MinHeight="35"><TextBlock Text="{Binding Month}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Income}" Classes="positive" TextAlignment="Right" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Outflow}" TextAlignment="Right" VerticalAlignment="Center" /><Border Grid.ColumnSpan="3" Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Bottom" /></Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
