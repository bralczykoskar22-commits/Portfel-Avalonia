<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Portfel.ViewModels"
             x:Class="Portfel.Views.GoalsView"
             x:DataType="vm:GoalsPageViewModel"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,24,30,34" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Text="Oszczędzaj według planu" Classes="h2" /><TextBlock Text="Wpłaty i wypłaty wpisujesz jako operacje. Resztę przelicza program." Classes="muted" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        <Button Grid.Column="1" Classes="primary" Content="＋ Dodaj cel" Command="{Binding Shell.AddGoalCommand}" />
      </Grid>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
          <StackPanel><TextBlock Text="ODŁOŻONO" Classes="eyebrow" /><TextBlock Text="{Binding Shell.GoalsSaved}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="{Binding Shell.GoalsTarget, StringFormat='Cel łącznie: {0}'}" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="POZOSTAŁO" Classes="eyebrow" /><TextBlock Text="{Binding Shell.GoalsRemaining}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="Do wszystkich aktywnych celów" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="ZALECANE WPŁATY" Classes="eyebrow" /><TextBlock Text="{Binding Shell.GoalsRecommended}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="Suma aktualnych planów" Classes="muted" FontSize="10" /></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="ZAKOŃCZONE" Classes="eyebrow" /><TextBlock Text="{Binding Shell.CompletedGoals}" Classes="metric" Margin="0,6,0,0" /><TextBlock Text="{Binding Shell.GoalCards.Count, StringFormat='z {0} celów'}" Classes="muted" FontSize="10" /></StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Shell.GoalCards}" IsVisible="{Binding Shell.HasGoals}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="385" Margin="0,0,14,14">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel><TextBlock Text="{Binding Name}" Classes="h2" /><TextBlock Text="{Binding Deadline}" Classes="muted" FontSize="10" /></StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="9,5"><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Classes.positive="{Binding IsComplete}" Classes.negative="{Binding IsOverdue}" /></Border>
                </Grid>
                <ProgressBar Value="{Binding Percent}" Maximum="100" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <StackPanel><TextBlock Text="ODŁOŻONO" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Saved}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="CEL" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Target}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="ZOSTAŁO" Classes="eyebrow" FontSize="9" /><TextBlock Text="{Binding Remaining}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                </Grid>
                <Border Classes="soft-card">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding RecommendationLabel}" Classes="muted" FontSize="10" /><TextBlock Text="Plan przelicza się po każdej zmianie" Classes="muted" FontSize="9" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Recommended}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" /></Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="primary" Content="Wpłać" Command="{Binding $parent[UserControl].DataContext.Shell.AddGoalContributionCommand}" CommandParameter="{Binding Id}" />
                    <Button Classes="soft" Content="Wypłać" Command="{Binding $parent[UserControl].DataContext.Shell.AddGoalWithdrawalCommand}" CommandParameter="{Binding Id}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="tiny" Content="Edytuj" Command="{Binding $parent[UserControl].DataContext.Shell.EditGoalCommand}" CommandParameter="{Binding Id}" />
                    <Button Classes="tiny danger" Content="×" Command="{Binding $parent[UserControl].DataContext.Shell.DeleteGoalCommand}" CommandParameter="{Binding Id}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" IsVisible="{Binding !Shell.HasGoals}">
        <StackPanel Margin="0,34" HorizontalAlignment="Center" Spacing="10">
          <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="◎" FontSize="28" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Nie masz jeszcze celu" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Dodaj kwotę i termin. Program sam policzy, ile trzeba odkładać." Classes="muted" TextAlignment="Center" />
          <Button Classes="primary" Content="Dodaj pierwszy cel" Command="{Binding Shell.AddGoalCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

