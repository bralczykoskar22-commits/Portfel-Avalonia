<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Portfel.ViewModels"
             x:Class="Portfel.Views.SettingsView"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,24,30,34" Spacing="18">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <StackPanel Spacing="5"><TextBlock Text="To są Twoje reguły działania programu" Classes="h2" /><TextBlock Text="Nie wpisujesz tu wypłaty ani wydatków. Ustawiasz tylko rok, dzień kolejnej wypłaty i moduły, z których chcesz korzystać." Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
          <Border Grid.Column="1" Classes="soft-card"><StackPanel><TextBlock Text="WERSJA" Classes="eyebrow" /><TextBlock Text="{Binding Shell.AppVersion}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <StackPanel><TextBlock Text="Podstawowe" Classes="h2" /><TextBlock Text="Ustawienia wspólne dla wszystkich miesięcy" Classes="muted" FontSize="10" /></StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6"><TextBlock Text="Domyślny rok" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding Shell.Years}" SelectedItem="{Binding Shell.SelectedYear}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Dzień wypłaty" Classes="muted" FontSize="11" /><NumericUpDown Value="{Binding Shell.PaydayDay}" Minimum="1" Maximum="31" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6"><TextBlock Text="Liczba kopii bezpieczeństwa" Classes="muted" FontSize="11" /><NumericUpDown Value="{Binding Shell.BackupLimit}" Minimum="3" Maximum="100" /></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><CheckBox IsChecked="{Binding Shell.ShowCents}" Content="Pokazuj grosze" /></StackPanel>
              </Grid>
              <TextBlock Text="Dzień wypłaty służy tylko do obliczenia, ile możesz bezpiecznie wydać dziennie i tygodniowo." Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel><TextBlock Text="Kategorie wydatków" Classes="h2" /><TextBlock Text="Jedna kategoria w każdym wierszu" Classes="muted" FontSize="10" /></StackPanel>
              <TextBox Text="{Binding Shell.CategoriesText}" AcceptsReturn="True" MinHeight="220" Watermark="Jedzenie&#x0a;Transport&#x0a;Rachunki" />
              <TextBlock Text="Kategorie są dostępne przy wydatkach, wpisach cyklicznych i limitach." Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel><TextBlock Text="Włącz lub wyłącz moduły" Classes="h2" /><TextBlock Text="Wyłączenie modułu nie usuwa jego danych." Classes="muted" FontSize="10" /></StackPanel>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Konta bankowe" FontWeight="SemiBold" /><TextBlock Text="Źródło gotówka/konto i przelewy między kontami" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.BankAccountsEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Import wyciągów CSV" FontWeight="SemiBold" /><TextBlock Text="Ręczny wybór pliku z podglądem i usuwaniem duplikatów" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.StatementImportEnabled}" IsEnabled="{Binding Shell.BankAccountsEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Ostrzeżenia" FontWeight="SemiBold" /><TextBlock Text="Terminy celów, długów i przekroczone limity" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.AlertsEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Odsetki dla długów" FontWeight="SemiBold" /><TextBlock Text="Pole oprocentowania pojawia się przy konkretnym długu" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.InterestEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Limit dzienny i tygodniowy" FontWeight="SemiBold" /><TextBlock Text="Bezpieczna kwota do kolejnej wypłaty" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.SpendingLimitsEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Wpisy cykliczne" FontWeight="SemiBold" /><TextBlock Text="Stałe wpływy i wydatki" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.RecurringEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Limity kategorii" FontWeight="SemiBold" /><TextBlock Text="Miesięczne koperty wydatkowe" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.EnvelopesEnabled}" /></Grid></Border>
              <Border Classes="soft-card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Prognoza" FontWeight="SemiBold" /><TextBlock Text="Uwzględnianie planowanych operacji" Classes="muted" FontSize="9" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Shell.ForecastEnabled}" /></Grid></Border>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="13">
              <StackPanel><TextBlock Text="Dane i kopie" Classes="h2" /><TextBlock Text="Baza jest lokalna, a zapis wykonujesz przyciskiem Zapisz." Classes="muted" FontSize="10" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="Zapisz teraz" Command="{Binding Shell.SaveCommand}" /><Button Classes="soft" Content="Eksportuj JSON" Command="{Binding Shell.ExportCommand}" /><Button Classes="soft" Content="Importuj JSON" Command="{Binding Shell.ImportCommand}" /></StackPanel>
              <Button Classes="soft" Content="Otwórz folder danych" Command="{Binding Shell.OpenDataFolderCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Shell.DatabasePath}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Ostatnie kopie" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Shell.Backups.Count}" Classes="muted" /></Grid>
              <ItemsControl ItemsSource="{Binding Shell.Backups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="34"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontSize="10" /><TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Classes="muted" FontSize="8" /></StackPanel><Button Grid.Column="1" Classes="tiny" Content="Przywróć" Command="{Binding $parent[UserControl].DataContext.Shell.RestoreBackupCommand}" CommandParameter="{Binding Path}" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Kopie pojawią się po kolejnych zapisach." Classes="muted" FontSize="9" IsVisible="{Binding !Shell.HasBackups}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Aktualizacje" Classes="h2" /><TextBlock Text="Dane pozostają w tym samym folderze, więc nowa wersja nie zeruje budżetu." Classes="muted" FontSize="10" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Classes="soft" Content="Sprawdź" Command="{Binding Shell.CheckUpdatesCommand}" /></Grid>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
